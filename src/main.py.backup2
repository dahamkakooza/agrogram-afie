# Initialize logger
logger = get_logger("main")


@asynccontextmanager
async def lifespan(app: FastAPI):
    """
    Lifespan context manager for startup and shutdown events.
    Production-ready with proper error handling and resource management.
    """
    startup_success = True
    startup_errors = []
    
    # ============ STARTUP ============
    logger.info("=" * 60)
    logger.info("STARTING AFIE SERVICE")
    logger.info(f"Environment: {settings.environment}")
    logger.info(f"Debug Mode: {settings.debug}")
    logger.info("=" * 60)
    
    try:
        # 1. Database initialization
        logger.info("Initializing database connection...")
        async with engine.begin() as conn:
            # Create tables if they don't exist
            await conn.run_sync(Base.metadata.create_all)
            logger.info("✓ Database tables verified/created")
            
            # Test connection
            from sqlalchemy import text
            result = await conn.execute(text("SELECT version()"))
            db_version = result.scalar()
            logger.info(f"✓ Connected to PostgreSQL: {db_version}")
    except Exception as e:
        startup_success = False
        error_msg = f"Database initialization failed: {str(e)}"
        startup_errors.append(error_msg)
        logger.error(error_msg)
        if settings.debug:
            logger.error(traceback.format_exc())
    
    try:
        # 2. Redis initialization
        logger.info("Initializing Redis connection...")
        redis_client = await get_redis_client()
        await redis_client.ping()
        logger.info("✓ Redis connection established")
    except Exception as e:
        startup_success = False
        error_msg = f"Redis initialization failed: {str(e)}"
        startup_errors.append(error_msg)
        logger.error(error_msg)
        if settings.debug:
            logger.error(traceback.format_exc())
    
    # 3. Feature flag validation
    logger.info("Checking feature flags...")
    active_features = []
    if settings.feature_farm_profiler:
        active_features.append("farm_profiler")
    if settings.feature_recommendations:
        active_features.append("recommendations")
    if settings.feature_learning_system:
        active_features.append("learning_system")
    if settings.feature_predictions:
        active_features.append("predictions")
    
    logger.info(f"✓ Active features: {', '.join(active_features) if active_features else 'None'}")
    
    # 4. Startup summary
    if startup_success:
        logger.info("=" * 60)
        logger.info("✅ AFIE SERVICE STARTED SUCCESSFULLY")
        logger.info(f"📡 API URL: http://{settings.host}:{settings.port}")
        logger.info(f"📚 Docs URL: http://{settings.host}:{settings.port}/docs")
        logger.info(f"🏥 Health URL: http://{settings.host}:{settings.port}/health")
        logger.info("=" * 60)
    else:
        logger.error("=" * 60)
        logger.error("❌ AFIE SERVICE STARTUP FAILED")
        for error in startup_errors:
            logger.error(f"  • {error}")
        logger.error("=" * 60)
        # Don't raise - let service start but mark as degraded
    
    # Yield control to application
    yield
    
    # ============ SHUTDOWN ============
    logger.info("=" * 60)
    logger.info("SHUTTING DOWN AFIE SERVICE")
    logger.info("=" * 60)
    
    try:
        # Close Redis connections
        await close_redis_connections()
        logger.info("✓ Redis connections closed")
    except Exception as e:
        logger.error(f"Redis shutdown error: {e}")
    
    try:
        # Dispose database engine
        await engine.dispose()
        logger.info("✓ Database connections closed")
    except Exception as e:
        logger.error(f"Database shutdown error: {e}")
    
    logger.info("✅ AFIE SERVICE SHUTDOWN COMPLETE")
    logger.info("=" * 60)


